# Postgres connection string for THIS project's own Neon database (not Pyrock's).
# Must include ?sslmode=require for Neon.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) URL, used by Prisma Migrate (`neon env pull` writes both).
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Anthropic API key — used by lib/llm/anthropic.ts and the eval runner.
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI API key — used by lib/llm/openai.ts when LLM_PROVIDER="openai".
OPENAI_API_KEY="sk-..."

# Which provider/model extracts notes: LLM_PROVIDER = anthropic | openai. The eval (npm run eval -- --models a,b)
# compares models on identical inputs; set the winner here.
LLM_PROVIDER="openai"
LLM_MODEL="gpt-6.1-terra"
# low | medium | high | xhigh | max
LLM_EFFORT="medium"
# Milliseconds before an extraction call is treated as a timeout (-> FAILED).
LLM_TIMEOUT_MS="30000"

# Sarvam AI speech-to-text (Phase 2, voice notes).
SARVAM_API_KEY="sk_..."
