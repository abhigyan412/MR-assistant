{
  "name": "mr-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && next build",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "audio:cleanup": "tsx scripts/audio-cleanup.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@neon/config": "^1.14.1",
    "@neon/env": "^2.1.4",
    "@prisma/client": "^6.19.3",
    "next": "^14.2.35",
    "openai": "^7.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dotenv": "^16.6.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
